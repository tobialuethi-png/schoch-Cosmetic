# Hostinger (Apache / LiteSpeed) – Regeln für den statischen Next.js-Export.

AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) ohne www -> mit www, ein Hop
  RewriteCond %{HTTP_HOST} ^schoch-cosmetic\.ch$ [NC]
  RewriteRule ^ https://www.schoch-cosmetic.ch%{REQUEST_URI} [R=301,L]

  # 2) Next.js Prefetch: der Build legt die Segment-Datei flach ab (scripts/flatten-segments.mjs,
  #    z. B. /behandlungsplan/__next.behandlungsplan.__PAGE__.txt). Fehlt die flache Datei,
  #    auf die exportierte Ordnerstruktur mappen.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/__next\.([^/]+)\.__PAGE__\.txt$ $1/__next.$2/__PAGE__.txt [L]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Alte Wix-Pfade → neue Anker (NE = "#" nicht escapen)
  RewriteRule ^(mpl4-technologie|mpl4|technologie)/?$ /#technologie [R=301,NE,L]
  RewriteRule ^(angebot-preise|preise)/?$ /#preise [R=301,NE,L]
  RewriteRule ^angebot/?$ /#angebot [R=301,NE,L]
  RewriteRule ^fusspflege/?$ /#fusspflege [R=301,NE,L]
  RewriteRule ^behandlungen/?$ /#leistungen [R=301,NE,L]
  RewriteRule ^haarentfernung/?$ /#haarentfernung [R=301,NE,L]
  RewriteRule ^(ueber-mich|über-mich|about)/?$ /#ueber-mich [R=301,NE,L]
  RewriteRule ^(kontakt-termine|kontakt|termine)/?$ /#kontakt [R=301,NE,L]
  RewriteRule ^(feedback-referenzen|referenzen|ergebnisse)/?$ /#praxis [R=301,NE,L]
  RewriteRule ^home/?$ / [R=301,L]
</IfModule>

# 3) Security-Header
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# 4) JS, CSS und Fonts ein Jahr cachen
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 5) HTML, Textdateien und XML immer neu prüfen (nach Deploy nie veraltete Seite aus dem Browser-Cache)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
