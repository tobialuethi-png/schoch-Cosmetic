"use client";
import { useRef } from "react";
import { gsap, useGSAP, ScrollTrigger } from "@/lib/gsap";
import { useMotionMode } from "@/lib/useMotionMode";
import { scrollToTarget } from "@/lib/lenis";
import { technology } from "@/lib/site";
import { dur, ease } from "@/lib/motion";
import Picture from "@/components/ui/Picture";
import type { ImageName } from "@/lib/images.generated";
import LuxButton from "@/components/ui/LuxButton";

/**
 * Section 5 — Technologie als Horizontal-Strecke (Horizontal Gallery / Scroll Chapter, gsap-motion §III.5 containerAnimation).
 *  · Die Section pinnt einen Bildschirm lang; der vertikale Scroll fährt die Bühne (.tech-track) seitwärts — 1 px Scroll = 1 px Fahrt.
 *  · Panel 0 = Intro (t-h2 mit Italic-Akzent, t-lead, CTA) + Handstück-Bild in gespiegelter Blattform (Echo zum Hero-Petal).
 *  · Panel 1–4 = die Argumente: Bild in kleiner Blattform + Ziffer, Titel, Text. Text-Kinder erscheinen gestaffelt, sobald das Panel
 *    einfährt (Trigger in der horizontalen Welt); Bilder laufen minimal gegen die Fahrtrichtung (Parallax, nur transform).
 *  · Ein wanderndes Licht (.tech-glow, vor-gerenderter Radialverlauf, nur transform) macht «Sanftes Licht» wörtlich.
 *  · Kapitel-Index unten links: vier Segmente, Segment i füllt sich, während Panel i den Bildschirm durchquert; klickbar.
 *  Ohne .is-pinned (mobil, reduced, lite): Intro im Fluss, die Argumente als natives Snap-Karussell (Swipe) — ohne Bewegung vollständig.
 */
const pad = (i: number) => String(i).padStart(2, "0");
const b = technology.benefits;
/* Bildregie: Intro = Handstück auf der Liege (wärmstes Bild); die Argumente wechseln zu Gesicht, Behandlung, Kunde, Gerät */
const intro = { image: "produkt", imageAlt: "MPL4-Handstück mit integrierter Wasserkühlung am Bein einer Kundin", position: "38% 50%" };
const chapters = [
  { title: b[0].title, text: b[0].text, image: "foto5", imageAlt: b[3].imageAlt, position: "50% 42%" },
  { title: b[1].title, text: b[1].text, image: "haar", imageAlt: b[1].imageAlt, position: "50% 40%" },
  { title: b[2].title, text: b[2].text, image: "foto7", imageAlt: b[2].imageAlt, position: "56% 40%" },
  { title: b[3].title, text: b[3].text, image: "erstesBild", imageAlt: "MPL4-Gerät Multipulselight 4G in der Praxis von Schoch Cosmetic", position: "50% 55%" },
];

/* Messwerte der Bühne (einmal pro Refresh gelesen, nie pro Frame) */
type Metrics = { off: number[]; a: number[]; b: number[]; edge: number; total: number };

export default function Technology() {
  const root = useRef<HTMLElement>(null);
  const track = useRef<HTMLDivElement>(null);
  const mode = useMotionMode();
  const stRef = useRef<ScrollTrigger | null>(null);
  const metrics = useRef<Metrics | null>(null);

  const { contextSafe } = useGSAP(() => {
    const mm = gsap.matchMedia();
    mm.add({ isDesktop: "(min-width: 768px)", isMobile: "(max-width: 767px)", reduce: "(prefers-reduced-motion: reduce)" }, (ctx) => {
      const { isDesktop, reduce } = ctx.conditions as { isDesktop: boolean; reduce: boolean };
      const el = root.current;
      const tr = track.current;
      if (!el || !tr) return;
      if (!isDesktop || reduce || mode === "lite") { el.classList.remove("is-pinned"); stRef.current = null; metrics.current = null; return; }
      el.classList.add("is-pinned");

      const q = gsap.utils.selector(el);
      const panels = q(".tech-panel") as HTMLElement[];
      const chapterEls = panels.slice(1);
      const bars = q(".tech-bar") as HTMLElement[];
      const labels = q(".tech-idx") as HTMLElement[];
      const glow = q(".tech-glow")[0] as HTMLElement | undefined;
      const n = chapterEls.length;

      // Fahrstrecke: letztes Panel + rechter Rand (= linker Rand) bündig im Bildschirm
      const edgeOf = () => parseFloat(getComputedStyle(tr).paddingLeft) || 0;
      const dist = () => {
        const last = panels[panels.length - 1];
        return Math.max(0, last.offsetLeft + last.offsetWidth + edgeOf() - tr.clientWidth);
      };
      // Aktiv ist das Panel, dessen Mitte der Bildschirmmitte am nächsten liegt: Segment i beginnt, wenn die Bildschirmmitte
      // die Mitte zwischen Panel i−1 und Panel i passiert, und läuft bis zur nächsten Übergabe; das letzte endet mit der Strecke
      const measure = () => {
        const vw = tr.clientWidth;
        const total = dist();
        const off = chapterEls.map((p) => p.offsetLeft);
        const center = panels.map((p) => p.offsetLeft + p.offsetWidth / 2);
        const a = off.map((_, i) => Math.max(0, (center[i] + center[i + 1]) / 2 - vw / 2));
        const bEnd = a.map((_, i) => (i < n - 1 ? a[i + 1] : total));
        metrics.current = { off, a, b: bEnd, edge: edgeOf(), total };
      };

      const barSet = bars.map((bar) => gsap.quickSetter(bar, "scaleX"));
      const glowX = glow ? gsap.quickSetter(glow, "xPercent") : null;
      const glowY = glow ? gsap.quickSetter(glow, "yPercent") : null;
      let active = -1;
      const setActive = (i: number) => {
        if (i === active) return;
        labels.forEach((l, k) => l.classList.toggle("is-active", k === i));
        active = i;
      };
      gsap.set(bars, { scaleX: 0 });

      const tween = gsap.to(tr, {
        x: () => -dist(),
        ease: "none",
        scrollTrigger: {
          trigger: el, start: "top top", end: () => `+=${dist()}`,
          pin: true, scrub: 1, anticipatePin: 1, invalidateOnRefresh: true,
          onRefresh: measure,
        },
        // Index + Licht folgen der SICHTBAREN Bühnenposition (Tween-Progress, nicht Scroll-Position) — nur Arithmetik, keine Layout-Reads
        onUpdate(this: gsap.core.Tween) {
          const m = metrics.current;
          if (!m) return;
          const p = this.progress();
          const x = p * m.total;
          if (glowX && glowY) { glowX(gsap.utils.interpolate(6, -28, p)); glowY(gsap.utils.interpolate(-10, 26, p)); }
          let cur = -1;
          for (let i = 0; i < n; i++) {
            barSet[i](gsap.utils.clamp(0, 1, (x - m.a[i]) / Math.max(1, m.b[i] - m.a[i])));
            if (x >= m.a[i]) cur = i;
          }
          setActive(cur);
        },
      });
      stRef.current = tween.scrollTrigger ?? null;
      measure();

      // Trigger INNERHALB der horizontalen Welt (containerAnimation)
      chapterEls.forEach((panel) => {
        const copy = panel.querySelector(".tech-ch-copy");
        const kids = copy ? (Array.from(copy.children) as HTMLElement[]) : [];
        if (kids.length) {
          gsap.set(kids, { autoAlpha: 0, y: 40 });
          gsap.to(kids, {
            autoAlpha: 1, y: 0, duration: dur.text, ease: ease.out, stagger: 0.08,
            scrollTrigger: { trigger: panel, containerAnimation: tween, start: "left 88%", once: true },
          });
        }
        const media = panel.querySelector<HTMLElement>(".tech-ch-media");
        const img = media?.querySelector("img");
        if (media && img) {
          gsap.fromTo(img, { xPercent: -6, scale: 1.14 }, {
            xPercent: 6, scale: 1.14, ease: "none",
            scrollTrigger: { trigger: media, containerAnimation: tween, start: "left right", end: "right left", scrub: true },
          });
        }
      });

      return () => {
        el.classList.remove("is-pinned");
        labels.forEach((l) => l.classList.remove("is-active"));
        stRef.current = null;
        metrics.current = null;
      };
    });
  }, { scope: root, dependencies: [mode], revertOnUpdate: true });

  // Index-Klick: Panel i bündig an den linken Rand fahren (ohne Pin: Karussell-Karte in den Blick)
  const goTo = contextSafe((i: number) => {
    const st = stRef.current;
    const m = metrics.current;
    if (st && m) {
      const p = gsap.utils.clamp(0, 1, (m.off[i] - m.edge) / Math.max(1, m.total));
      scrollToTarget(st.start + (st.end - st.start) * p, { offset: 0 });
      return;
    }
    root.current?.querySelectorAll<HTMLElement>(".tech-chapter")[i]?.scrollIntoView({ inline: "start", block: "nearest", behavior: "smooth" });
  });

  return (
    <section ref={root} id="technologie" data-deck="bloom-l" className="tech bg-cream" aria-labelledby="tech-title" data-reveal-scope>
      <div className="deck-inner tech-wash relative" style={{ "--tone": "var(--color-linen)" } as React.CSSProperties}>
        <div className="deck-wash" aria-hidden="true" />
        <span className="tech-glow" aria-hidden="true" />
        <span className="tech-glow tech-glow--sage" aria-hidden="true" />
        <div className="section tech-section relative">
          {/* Bühne: fährt gepinnt seitwärts (Desktop, full) — sonst normaler Fluss */}
          <div ref={track} className="tech-track">
            {/* Panel 0 — Intro */}
            <div className="tech-panel tech-intro">
              <div className="tech-copy [container-type:inline-size]">
                <p className="t-eyebrow text-orange-ink" data-reveal>Technologie · <span className="hidden sm:inline">{technology.device}</span><span className="sm:hidden">MPL4</span></p>
                <h2 id="tech-title" className="t-h2 tech-title mt-7 md:mt-8" data-reveal-text>
                  Sanftes Licht. <em>Tiefgehende</em> Wirkung.
                </h2>
                <p className="t-lead mt-7 max-w-[540px] text-umber" data-reveal>{technology.lead}</p>
                <div className="mt-10" data-reveal>
                  <LuxButton href={technology.cta.href}>{technology.cta.label}</LuxButton>
                </div>
              </div>

              <div className="tech-media">
                <div className="tech-petal relative w-full bg-linen" data-reveal-img="bottom">
                  <Picture
                    name={intro.image as ImageName}
                    alt={intro.imageAlt}
                    sizes="(min-width: 1280px) 46vw, (min-width: 768px) 50vw, 92vw"
                    className="block h-full w-full"
                    imgClassName="h-full w-full object-cover"
                    position={intro.position}
                  />
                  <span className="absolute bottom-6 left-6 z-[6] inline-flex items-center gap-2.5 rounded-full bg-cream/92 px-4 py-2.5 t-eyebrow text-ink md:bottom-8 md:left-8">
                    <span className="h-1.5 w-1.5 rounded-full bg-orange" aria-hidden="true" />
                    {technology.device}
                  </span>
                </div>
              </div>
            </div>

            {/* Panel 1–4 — die Argumente, fahren von rechts ein (ohne Pin: natives Snap-Karussell) */}
            <div className="tech-rail" role="group" aria-label="Vorteile der MPL4-Technologie">
              {chapters.map((c, i) => (
                <div key={c.title} className="tech-panel tech-chapter">
                  <div className="tech-petal tech-ch-media relative bg-linen">
                    <Picture
                      name={c.image as ImageName}
                      alt={c.imageAlt}
                      sizes="(min-width: 1280px) 34vw, (min-width: 768px) 40vw, 78vw"
                      className="block h-full w-full"
                      imgClassName="h-full w-full object-cover"
                      position={c.position}
                    />
                  </div>
                  <div className="tech-ch-copy">
                    <p className="t-eyebrow tnum text-orange-ink">
                      <span aria-hidden="true">{pad(i + 1)} <span className="text-ink/35">/ {pad(chapters.length)}</span></span>
                      <span className="sr-only">Vorteil {i + 1} von {chapters.length}</span>
                    </p>
                    <h3 className="t-chapter tech-ch-title mt-4">{c.title}</h3>
                    <p className="t-lead mt-5 text-umber">{c.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Kapitel-Index: Segment + Ziffer + Titel, füllt sich, während das Panel durchfährt (nur gepinnt sichtbar) */}
          <ol className="tech-index grid grid-cols-4 gap-4 lg:gap-5" data-reveal aria-label="Kapitel">
            {chapters.map((c, i) => (
              <li key={c.title} className="tech-idx">
                <button type="button" onClick={() => goTo(i)} className="group block w-full text-left">
                  <span className="block h-px w-full bg-ink/15" aria-hidden="true">
                    <span className="tech-bar block h-full w-full bg-orange-ink" />
                  </span>
                  <span className="mt-3 block t-eyebrow tnum text-orange-ink">{pad(i + 1)}</span>
                  <span className="mt-1 block t-small leading-tight text-ink transition-colors duration-150 group-hover:text-orange-ink">{c.title}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  );
}
